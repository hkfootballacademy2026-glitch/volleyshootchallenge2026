{
  "expo": {
    "name": "VOLLEYSHOOT CHALLENGE",
    "slug": "volleyshoot-challenge",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "volleyshoot",
    "splash": {
      "backgroundColor": "#07090F"
    },
    "assetBundlePatterns": [
      "assets/models/*"
    ],
    "ios": {
      "bundleIdentifier": "com.volleyshoot.challenge",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ボレーシュートの練習のため、カメラで足の動きをリアルタイムに検出します。映像は端末内でのみ処理されます。",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "このアプリ本体は位置情報を使用しませんが、一部の外部ライブラリが位置情報APIを参照するため、App Store Connectの要件に合わせて利用目的を明記しています。",
        "CFBundleDisplayName": "ボレチャレ"
      }
    },
    "android": {
      "package": "com.volleyshoot.challenge",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07090F"
      }
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ボレーシュートの練習のため、カメラで足の動きをリアルタイムに検出します。映像は端末内でのみ処理されます。",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-5840457424714744~7348432585",
          "userTrackingUsageDescription": "広告効果の測定と、より関連性の高い広告を表示するために使用します。"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bcaa8440-ad34-4220-903a-9ba204ea06cb"
      }
    }
  }
}
